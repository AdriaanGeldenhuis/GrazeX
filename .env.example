# =====================================================================
# GrazeX settings — copy this file to ".env" (or put the same values in ".env.php")
# in the website root (public_html). It is never committed to git and never
# overwritten by the deploy. Dotfiles are blocked from the web by .htaccess.
# =====================================================================

# Site
APP_URL=https://grazex.co.za
APP_DEBUG=false
# 64 random characters — e.g. run: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# Any long secret word; you type it once on /setup/ to create the owner account
SETUP_TOKEN=

# Database (Xneelo: Manage MySQL — host looks like dediNNN.cpt1.host-h.net or sqlNN.jnbN.host-h.net)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Email (Xneelo: smtp.<your-domain>, port 465 + ssl, username = full email address)
MAIL_HOST=smtp.grazex.co.za
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=orders@grazex.co.za
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=orders@grazex.co.za
MAIL_FROM_NAME=GrazeX
MAIL_ADMIN=orders@grazex.co.za

# Yoco card payments (Yoco app > Checkout API). Use test keys first.
YOCO_MODE=test
YOCO_TEST_SECRET_KEY=
YOCO_LIVE_SECRET_KEY=
# Webhook secrets are filled in automatically by Admin > Settings > "Connect Yoco webhook"
YOCO_TEST_WEBHOOK_SECRET=
YOCO_LIVE_WEBHOOK_SECRET=
